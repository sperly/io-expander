	(text "CC1 / CC2 5.1k: USB device, up to 500 mA from VBUS.\nD4: USB VBUS -> +5V (about 4.6 V); J1 and USB may be connected together.\nUART_RX = MAX3160 RO AND CH340C TXD (D5, 4.7k pull-up): both host links\nare live; use only one at a time. UART_TX drives both."
		(exclude_from_sim no)
		(at 162.56 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7aa2fb55-e591-414d-9fbc-b67a6c650509")
	)
	(text "+5 V"
		(exclude_from_sim no)
		(at 292.1 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8e6e7ca6-3def-4a11-a3e4-4ddc41ec098c")
	)
	(text "RS-485: fit TERM only at the two physical bus ends;\n        fit BIAS A + BIAS B on one node only (normally the master).\nRS-232: REMOVE TERM, BIAS A and BIAS B (they would load TXD).\nD2 SM712: -7 / +12 V TVS for the bus pins.\nD3: 15 V bidirectional TVS for the RS-232 receiver input."
		(exclude_from_sim no)
		(at 238.76 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9244c081-3dcc-43bb-ac15-ac0d79c6d4f7")
	)
