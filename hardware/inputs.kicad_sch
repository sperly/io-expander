		(uuid "0049605b-fc91-4144-a36d-fdfb4db9dd4c")
	)
	(text "Active input -> LED current -> phototransistor on -> GPx low -> reads 1 (IPOL = 1).\nInput voltage 5 - 24 V (max 30 V): on above about 4 V, off below about 2 V.\nInput current about 0.9 mA at 5 V, 6.6 mA at 24 V (3.3k / 0.25 W series resistor).\nIN1-4 / COM1 and IN5-8 / COM2 are two isolated groups, each wired sink or source.\nIsolation 2.5 kV (TLP290-4); keep the field side clear of logic copper on the PCB."
		(exclude_from_sim no)
		(at 15.24 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0e2ab703-b968-472a-883a-ba65414d5663")
	)
	(text "sink (NPN sensor, switch to GND)"
		(exclude_from_sim no)
		(at 15.24 136.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "14ade85b-3b48-492b-bb29-0839691355ad")
	)
	(text "IN is connected to GND"
		(exclude_from_sim no)
		(at 101.6 136.14 0)
		(effects
