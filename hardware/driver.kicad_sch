	(text "HALF-BRIDGE DRIVER   DRV8912-Q1   (OUT1..OUT8 used)"
		(exclude_from_sim no)
		(at 16.51 21.59 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "da8640bc-f261-431f-a869-ea8ab91e5da6")
	)
	(text "SPI mode 1 (CPOL 0, CPHA 1), 16-bit frames, <= 5 MHz.\nnSLEEP has a pull-down: outputs stay off until firmware wakes the driver.\nnFAULT is also reported over SPI; J5 is a test point.\nVM bulk 22 uF + 10 uF keeps >= 10 uF effective at 14 V (DC bias).\nOUT9..OUT12 are not used: keep them disabled in firmware."
		(exclude_from_sim no)
		(at 20.32 182.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2d1624fe-aa34-478f-a5f6-b9ecef3524b8")
	)
	(text "OUTPUT TERMINALS   (2.54 mm screw)"
		(exclude_from_sim no)
		(at 265.43 21.59 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b19308d1-b0e2-423d-901b-7c2e8c559eaa")
	)
	(text "OUTx: off, low-side switch, high-side\nswitch or push-pull, optionally PWM.\nLow-side / high-side loads are returned to\nthe VIO / GND pins of the same terminal.\nDo not drive OUTx externally above VIO\nor below GND (body diodes)."
		(exclude_from_sim no)
		(at 269.24 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "30fa46d0-3e0b-4def-80c0-dcd2e695e8b6")
	)
