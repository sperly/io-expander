		(uuid "a7b7484d-28a2-4c44-b515-f312d3147138")
	)
	(text "J1: regulated 5 V (4.75 - 5.25 V).  AP2112K 600 mA LDO, board logic < 50 mA.\nNo reverse-polarity protection: check the wiring before applying power."
		(exclude_from_sim no)
		(at 20.32 71.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "987ed789-54b8-4f54-bcd1-6fc78de3e209")
	)
	(text "OUTPUT DRIVER SUPPLY  VIO   (4.5 - 14 V)"
		(exclude_from_sim no)
		(at 16.51 102.87 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "d030ef77-21b3-41ce-9132-9e4ab01eca9e")
	)
	(text "JP1 1-2 : VIO from J2 (external 4.5 - 14 V)\nJP1 2-3 : VIO = on-board +5 V\nFit exactly one shunt, move it only with power removed.\nVIO supplies the DRV8912 VM pins and the VIO pins of the output terminals."
		(exclude_from_sim no)
		(at 20.32 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d6f5793f-e7e5-486b-a7b0-3d1f957556db")
	)
	(text "VIO MONITOR  (ADC)"
		(exclude_from_sim no)
		(at 214.63 102.87 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a90b3d6c-d137-4241-92c6-b3b3beb2fa62")
	)
	(text "VIO_ADC = VIO x 22k / 122k   (14 V -> 2.52 V)\nD1 clamps the ADC pin to GND / +3V3.\nUse a long ADC sample time (source ~18 kOhm)."
		(exclude_from_sim no)
		(at 218.44 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "29b1b4b9-11d9-4d88-86d4-da227527b64d")
	)
