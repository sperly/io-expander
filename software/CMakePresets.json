{
  "version": 6,
  "configurePresets": [
    {
      "name": "firmware",
      "displayName": "STM32G030 firmware (arm-none-eabi-gcc)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" }
    },
    {
      "name": "firmware-debug",
      "inherits": "firmware",
      "displayName": "STM32G030 firmware, debug",
      "binaryDir": "${sourceDir}/build/firmware-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-tests",
      "displayName": "Host unit tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "firmware", "configurePreset": "firmware" },
    { "name": "firmware-debug", "configurePreset": "firmware-debug" },
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    { "name": "host-tests", "configurePreset": "host-tests", "output": { "outputOnFailure": true } }
  ]
}
